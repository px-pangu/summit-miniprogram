/* ---------- 用户信息区 ---------- */
.me-hero {
  background: var(--grad-hero);
  padding: 64rpx 40rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.me-avatar-btn {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
}
.me-avatar-btn::after { border: none; }
.me-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  background: #fff;
}
.me-avatar-ph {
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
.me-avatar-icon {
  width: 56rpx;
  height: 56rpx;
}
.me-avatar-edit {
  border-style: dashed;
}
.me-avatar-cam {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
.me-avatar-cam-icon {
  width: 24rpx;
  height: 24rpx;
}
.me-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 24rpx;
}
.me-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.me-edit-icon {
  opacity: 0.75;
}
.me-login-btn {
  margin-top: 32rpx;
  background: #fff;
  color: var(--primary);
}

/* ---------- 编辑态 ---------- */
.me-edit {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.me-edit-input {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  height: 80rpx;
  padding: 0 32rpx;
  color: #fff;
  font-size: 28rpx;
}
.me-edit-input .ph,
.me-edit-input {
  --ph: #B6BECD;
}
.me-edit-btns {
  display: flex;
  gap: 20rpx;
}
.me-edit-btns .btn {
  flex: 1;
}

/* ---------- 菜单 ---------- */
.menu {
  padding: 8rpx 28rpx;
  margin-top: 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-press {
  opacity: 0.7;
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mi-p { background: linear-gradient(135deg, #3D74F2, #1B3FD6); }
.mi-a { background: linear-gradient(135deg, #F6B33D, #E08A12); }
.mi-b { background: linear-gradient(135deg, #34C97B, #128A4F); }
.mi-n { background: linear-gradient(135deg, #8A97AD, #5D6B82); }
.menu-txt {
  font-size: 29rpx;
  color: var(--ink);
}
.me-foot {
  text-align: center;
  margin-top: 60rpx;
}
