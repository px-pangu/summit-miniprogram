.tabs {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.tab {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 25rpx;
  box-shadow: var(--shadow-card);
}
.tab-on {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

/* ---------- 记录卡片 ---------- */
.rec {
  margin-bottom: 24rpx;
}
.rec-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.rec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  flex: 1;
}
.rec-line {
  margin-top: 14rpx;
  font-size: 24rpx;
}
.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
.rec-actions {
  display: flex;
  gap: 16rpx;
}

/* ---------- 骨架 ---------- */
.skel-card {
  padding: 36rpx 28rpx;
}
.skel-line {
  height: 26rpx;
  border-radius: 8rpx;
  background: #EDF1F8;
  margin-bottom: 20rpx;
}
.w60 { width: 60%; }
.w70 { width: 70%; }
.w90 { width: 90%; }
