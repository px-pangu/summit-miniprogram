/* ---------- 顶部品牌区 ---------- */
.hero {
  background: var(--grad-hero);
  padding: 56rpx 40rpx 150rpx;
  position: relative;
}
.hero-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.hero-badge-icon {
  width: 40rpx;
  height: 40rpx;
}
.hero-en {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-bottom: 10rpx;
}
.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.hero-slogan {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 12rpx;
}
.hero-meta {
  display: flex;
  gap: 32rpx;
  margin-top: 28rpx;
}
.hero-meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
}
.hero-stats {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: -76rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(18, 43, 133, 0.16);
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}
.hero-stat {
  flex: 1;
  text-align: center;
}
.hero-stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.15;
}
.hero-stat-lab {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.hero-stat-div {
  width: 2rpx;
  height: 52rpx;
  background: var(--line);
}

/* ---------- 搜索 ---------- */
.search {
  margin-top: 116rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.ph { color: #B6BECD; }

/* ---------- 筛选 Tabs ---------- */
.tabs {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0 24rpx;
}
.tab {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 25rpx;
  box-shadow: var(--shadow-card);
}
.tab-on {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

/* ---------- 活动卡片 ---------- */
.act {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.press { opacity: 0.88; }
.act-cover-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}
.act-cover {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}
.act-cover-ph {
  background: linear-gradient(135deg, #E8EFFE, #D6E2FB);
  display: flex;
  align-items: center;
  justify-content: center;
}
.act-cover-ph-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.8;
}
.act-flag {
  position: absolute;
  left: 0;
  bottom: 0;
  border-radius: 0 16rpx 0 16rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
}
.act-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}
.act-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.act-line {
  margin-top: 10rpx;
  font-size: 23rpx;
}
.act-quota {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}
.act-quota-num {
  font-size: 22rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.act-go {
  align-self: center;
  margin-left: 8rpx;
}

/* ---------- 骨架屏 ---------- */
.skel-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #EDF1F8;
}
.skel-line {
  height: 26rpx;
  border-radius: 8rpx;
  background: #EDF1F8;
  margin-top: 16rpx;
}
.w70 { width: 70%; }
.w90 { width: 90%; }
.w50 { width: 50%; }
