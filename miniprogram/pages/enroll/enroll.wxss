/* ---------- 顶部摘要 ---------- */
.summit-bar {
  background: var(--grad-hero);
  padding: 40rpx 32rpx 34rpx;
}
.summit-bar-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.summit-bar-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 14rpx;
}
.summit-bar-div {
  margin: 0 6rpx;
  opacity: 0.5;
}

/* ---------- picker ---------- */
.form-picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.form-picker.ph {
  color: #B6BECD;
}

/* ---------- 住宿 ---------- */
.hotel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid var(--line);
  margin-top: 24rpx;
  padding-top: 24rpx;
}
.hotel-lab {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  color: var(--ink);
}

/* ---------- 备注 ---------- */
.remark {
  width: 100%;
  height: 160rpx;
  font-size: 27rpx;
  line-height: 1.6;
}
.remark-count {
  text-align: right;
  margin-top: 8rpx;
}

/* ---------- 协议 ---------- */
.agree {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 32rpx;
  padding: 0 8rpx;
}
.agree-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C4CDDC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.agree-on {
  background: var(--primary);
  border-color: var(--primary);
}
.agree-check {
  width: 22rpx;
  height: 22rpx;
}
.agree-link {
  color: var(--primary);
}

.footer-gap {
  height: 40rpx;
}
.page {
  padding-bottom: 180rpx;
}

/* ---------- 成功页 ---------- */
.success-card {
  padding: 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}
.success-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34C97B, var(--green));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(22, 163, 74, 0.28);
  margin-bottom: 28rpx;
}
.success-check {
  width: 56rpx;
  height: 56rpx;
}
.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.success-card .t-sub {
  margin-top: 10rpx;
  text-align: center;
}
.success-info {
  width: 100%;
  background: #F7F9FC;
  border-radius: 18rpx;
  padding: 10rpx 28rpx;
  margin-top: 34rpx;
}
.si-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #ECF0F6;
}
.si-row:last-child {
  border-bottom: none;
}
.si-lab {
  font-size: 25rpx;
  color: var(--ink-3);
}
.si-val {
  font-size: 26rpx;
  color: var(--ink);
  text-align: right;
  max-width: 420rpx;
}
.si-strong {
  font-weight: 700;
}
.si-code {
  letter-spacing: 4rpx;
  color: var(--primary);
}
