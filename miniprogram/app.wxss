/* ======================= 设计令牌 ======================= */
page {
  --primary: #2456E8;
  --primary-deep: #16389E;
  --primary-soft: #EBF0FE;
  --ink: #0F172A;
  --ink-2: #475569;
  --ink-3: #94A3B8;
  --bg: #F4F6FA;
  --card: #FFFFFF;
  --line: #EDF0F5;
  --green: #16A34A;
  --green-soft: #E8F7EE;
  --amber: #B45309;
  --amber-soft: #FEF3E2;
  --red: #E5484D;
  --red-soft: #FDEBEC;
  --grad-hero: linear-gradient(135deg, #2E6BF6 0%, #1B3FD6 58%, #122B85 100%);
  --shadow-card: 0 6rpx 24rpx rgba(15, 23, 42, 0.05);
  --shadow-btn: 0 10rpx 28rpx rgba(36, 86, 232, 0.32);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

/* ======================= 布局 ======================= */
.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  padding: 24rpx 28rpx 48rpx;
}

/* ======================= 卡片 ======================= */
.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx;
}

/* ======================= 文本 ======================= */
.t-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.t-sub {
  font-size: 26rpx;
  color: var(--ink-2);
}
.t-hint {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 区块标题 */
.sec {
  display: flex;
  align-items: center;
  margin: 36rpx 4rpx 20rpx;
}
.sec-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--primary);
  margin-right: 14rpx;
}
.sec-txt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.sec-extra {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
  display: flex;
  align-items: center;
}

/* ======================= 按钮 ======================= */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: opacity 0.15s ease;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: var(--shadow-btn);
}
.btn-primary.disabled {
  background: #B9C6EA;
  box-shadow: none;
  color: #F2F5FC;
}
.btn-ghost {
  background: var(--primary-soft);
  color: var(--primary);
}
.btn-outline {
  background: #fff;
  color: var(--ink-2);
  border: 2rpx solid var(--line);
}
.btn-danger {
  background: var(--red-soft);
  color: var(--red);
}
.btn-sm {
  height: 64rpx;
  padding: 0 30rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  gap: 8rpx;
}
.btn-block {
  width: 100%;
}

/* ======================= 标签 ======================= */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}
.tag-p { background: var(--primary-soft); color: var(--primary); }
.tag-g { background: var(--green-soft); color: var(--green); }
.tag-a { background: var(--amber-soft); color: var(--amber); }
.tag-r { background: var(--red-soft); color: var(--red); }
.tag-n { background: #F1F4F9; color: var(--ink-3); }

/* ======================= 图标 ======================= */
.icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.icon-sm {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
.icon-lg {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

/* 信息行：图标 + 文本 */
.meta-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

/* ======================= 进度条 ======================= */
.progress {
  height: 12rpx;
  background: #EAEFF8;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F82F5, var(--primary));
}

/* ======================= 空状态 ======================= */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EDF1F8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-txt {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-bottom: 28rpx;
}

/* ======================= 表单 ======================= */
.form-card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
}
.form-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.form-item:last-child {
  border-bottom: none;
}
.form-label {
  width: 168rpx;
  font-size: 28rpx;
  color: var(--ink);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.form-label .req {
  color: var(--red);
  font-weight: 600;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.form-input-ph {
  color: #B6BECD;
}
.form-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* chips 选项 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #F1F4F9;
  color: var(--ink-2);
  font-size: 25rpx;
  border: 2rpx solid transparent;
}
.chip-on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: rgba(36, 86, 232, 0.35);
  font-weight: 500;
}

/* ======================= 底部操作栏 ======================= */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 50;
}
.footer-price {
  display: flex;
  flex-direction: column;
}
.footer-price .num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}
.footer-price .lab {
  font-size: 22rpx;
  color: var(--ink-3);
}
.footer-btn {
  flex: 1;
}

/* ======================= 通用工具 ======================= */
.row {
  display: flex;
  align-items: center;
}
.grow {
  flex: 1;
}
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
